[Unit]
Description=PostParser production storage maintenance
After=postparser-prod.service

[Service]
Type=oneshot
User=postparser-prod
Group=postparser-prod
WorkingDirectory=/opt/postparser-prod
EnvironmentFile=/etc/postparser-prod.env
ExecStart=/opt/postparser-prod/venv/bin/flask --app server.web_wsgi:app maintain-storage

