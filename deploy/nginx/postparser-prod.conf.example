# Temporary private validation host. Replace the placeholder only during rollout.
server {
    listen 443 ssl;
    server_name postparser-new.example.invalid;

    # Reuse the approved certificate configuration for the chosen validation host.
    ssl_certificate /etc/letsencrypt/live/PLACEHOLDER/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PLACEHOLDER/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5052;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 320s;
        proxy_send_timeout 320s;
    }
}
