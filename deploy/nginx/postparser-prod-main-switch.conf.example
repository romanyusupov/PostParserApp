# Future main-domain switch. Keep the previous 5050 configuration backed up
# and apply this only after controlled validation of the production service.
upstream postparser_main {
    server 127.0.0.1:5052;
}

server {
    listen 443 ssl;
    server_name tg-parser.proactivum.ru;

    ssl_certificate /etc/letsencrypt/live/tg-parser.proactivum.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tg-parser.proactivum.ru/privkey.pem;

    location / {
        proxy_pass http://postparser_main;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 320s;
        proxy_send_timeout 320s;
    }
}
